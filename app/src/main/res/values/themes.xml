<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- No action bar: with targetSdk 35+ the app is always edge to edge and the framework
         action bar ended up over the content. Each screen draws its own title instead. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
