#!/bin/sh /etc/rc.common
#
# adb-reporter: installed by Wireless ADB Reporter, removed by
# /usr/share/adb-reporter/uninstall.sh
#
# Its own uhttpd process for the receiver CGI, so /etc/config/uhttpd and the
# LuCI web server are never touched. Settings in /etc/config/adb_reporter,
# a "uci commit adb_reporter" restarts it with the new port.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/uhttpd
DOCROOT=/usr/share/adb-reporter/www

start_service() {
    local port listen

    config_load adb_reporter
    config_get port main port 8765
    listen="-p 0.0.0.0:$port"

    # uhttpd gives up entirely when one bind fails, so IPv6 only where the kernel has it
    if [ -e /proc/net/if_inet6 ]; then
        listen="$listen -p [::]:$port"
    fi

    # -D: no directory listings, -n/-N: a handful of phones, never more
    procd_open_instance
    procd_set_param command "$PROG" -f -D -h "$DOCROOT" -x /api $listen \
        -n 5 -N 20 -t 15 -T 15
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger adb_reporter
}
