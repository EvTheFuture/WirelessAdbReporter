# /etc/config/adb_reporter, optional. Wireless ADB Reporter's CGI script
# reads it on every request, without it the defaults below apply.
config adb_reporter 'main'
	# Bearer token the phones send, empty accepts anyone on the LAN
	option token ''

	# Reports live in RAM, the phones send a heartbeat every 5 minutes so a
	# reboot is refilled quickly and the flash is never written
	option state_dir '/tmp/adb-reporter'

	# Seconds without a report before a device is flagged stale
	option stale_after '900'

	# 1 allows GET requests without the token
	option open_get '0'

	# Shell command run when a device's ip:port changes, with ADB_DEVICE_ID,
	# ADB_NAME, ADB_IP, ADB_PORT, ADB_CONNECT, ADB_PREVIOUS and ADB_SERIAL set.
	# hook_always 1 also runs it on every heartbeat
	option hook ''
	option hook_always '0'
