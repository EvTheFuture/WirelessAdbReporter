#!/bin/sh
#
# Wireless ADB Reporter receiver as a CGI script, the same API as
# server/adb-reporter-server.py without Python. Not a daemon: the web server
# starts it for each request and it exits when it has answered. With the
# script at <cgi prefix>/adb the API is:
#
#   POST <prefix>/adb                      JSON report from the phone
#   GET  <prefix>/adb                      all devices as JSON
#   GET  <prefix>/adb/<device_id>          one device as JSON
#   GET  <prefix>/adb/<device_id>/connect  plain "ip:port", for scripts
#
# Lookups match device_id first, then the adb serial, then the name, all
# case insensitive.
#
# Runs on OpenWrt and on any other system with a CGI capable web server
# (uhttpd, busybox httpd, lighttpd, nginx with fcgiwrap, ...):
#
#   OpenWrt   busybox ash, jsonfilter and jshn, settings in /etc/config/adb_reporter
#   elsewhere a POSIX sh and jq, settings in /etc/adb-reporter.conf, or the
#             file named by ADB_REPORTER_CONF in the CGI environment
#
# jq is used whenever it is installed, so OpenWrt with jq takes that path too.

MAX_BODY=65536

# ----------------------------------------------------------------------
# JSON backend
# ----------------------------------------------------------------------

if command -v jq >/dev/null 2>&1; then
    JSON=jq
elif command -v jsonfilter >/dev/null 2>&1 && [ -f /usr/share/libubox/jshn.sh ]; then
    JSON=jshn
    . /usr/share/libubox/jshn.sh
else
    printf 'Status: 500 Internal Server Error\r\nContent-Type: application/json\r\n\r\n'
    printf '{ "error": "jq, or jsonfilter and jshn, is required" }\n'
    exit 0
fi

# One field of a JSON file as text, empty when missing
json_file_field() {

    if [ "$JSON" = jq ]; then
        jq -r --arg f "$2" '.[$f] // empty | tostring' "$1" 2>/dev/null
    else
        jsonfilter -i "$1" -e "@.$2" 2>/dev/null
    fi
}

# True when the string is a JSON object
json_is_object() {

    if [ "$JSON" = jq ]; then
        [ "$(printf '%s' "$1" | jq -r 'type' 2>/dev/null)" = object ]
    else
        [ "$(jsonfilter -s "$1" -t '@' 2>/dev/null)" = object ]
    fi
}

# Shell assignments r_<field>=<quoted value> for the report fields in $1
json_report_vars() {
    local fields="device_id name model serial ip port ssid android reason"
    local field body="$1"

    if [ "$JSON" = jq ]; then
        printf '%s' "$body" | jq -r --arg fields "$fields" '
            . as $r
            | $fields | split(" ")[]
            | "r_\(.)=" + (($r[.] // "") | tostring | @sh)' 2>/dev/null
        return
    fi

    # The positional parameters are reused for the -e arguments, the body was saved above
    set --

    for field in $fields; do
        set -- "$@" -e "r_$field=@.$field"
    done

    jsonfilter -s "$body" "$@" 2>/dev/null
}

# The stored record from the r_* variables and a few more, on stdout
json_record() {

    if [ "$JSON" = jq ]; then
        jq -n \
            --arg device_id "$id" --arg name "${r_name:-$id}" --arg model "$r_model" \
            --arg serial "$r_serial" --arg ip "$r_ip" --argjson port "$r_port" \
            --arg connect "$endpoint" --arg ssid "$r_ssid" --arg android "$r_android" \
            --arg reason "$r_reason" --argjson reported_at "$now" \
            --arg remote_addr "$REMOTE_ADDR" \
            '$ARGS.named'
        return
    fi

    json_init
    json_add_string device_id "$id"
    json_add_string name "${r_name:-$id}"
    json_add_string model "$r_model"
    json_add_string serial "$r_serial"
    json_add_string ip "$r_ip"
    json_add_int port "$r_port"
    json_add_string connect "$endpoint"
    json_add_string ssid "$r_ssid"
    json_add_string android "$r_android"
    json_add_string reason "$r_reason"
    json_add_int reported_at "$now"
    json_add_string remote_addr "$REMOTE_ADDR"
    json_dump
}

# A stored record plus age_seconds and stale. $2 is "pretty" for indented output
describe() {
    local reported_at age now

    now=$(date +%s)

    if [ "$JSON" = jq ]; then
        jq $([ "$2" = pretty ] || echo -c) --argjson now "$now" --argjson stale_after "$STALE_AFTER" '
            (($now - (.reported_at // 0)) | if . < 0 then 0 else . end) as $age
            | . + { age_seconds: $age, stale: ($age > $stale_after) }' "$1" 2>/dev/null
        return
    fi

    json_load "$(cat "$1")" 2>/dev/null || return 1
    json_get_var reported_at reported_at
    age=$((now - ${reported_at:-0}))

    if [ "$age" -lt 0 ]; then
        age=0
    fi

    json_add_int age_seconds "$age"
    json_add_boolean stale "$([ "$age" -gt "$STALE_AFTER" ] && echo 1 || echo 0)"
    json_dump $([ "$2" = pretty ] && echo -i)
}

# ----------------------------------------------------------------------
# Settings
# ----------------------------------------------------------------------

CONF=${ADB_REPORTER_CONF:-/etc/adb-reporter.conf}

# One option, or the default when unset. On OpenWrt from uci, otherwise from
# "name=value" lines in $CONF. The file is read, never sourced, so it cannot
# run code as the web server user
option() {
    local value=""

    if command -v uci >/dev/null 2>&1 && [ -f /etc/config/adb_reporter ]; then
        value=$(uci -q get "adb_reporter.main.$1" 2>/dev/null)
    elif [ -r "$CONF" ]; then
        value=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" | tail -n 1)

        # Surrounding single or double quotes are optional
        value=${value%\"}
        value=${value#\"}
        value=${value%\'}
        value=${value#\'}
    fi

    printf '%s' "${value:-$2}"
}

TOKEN=$(option token "")
STATE_DIR=$(option state_dir /tmp/adb-reporter)
STALE_AFTER=$(option stale_after 900)
OPEN_GET=$(option open_get 0)
HOOK=$(option hook "")
HOOK_ALWAYS=$(option hook_always 0)

case "$STALE_AFTER" in
    ''|*[!0-9]*) STALE_AFTER=900 ;;
esac

# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------

log() {
    logger -t adb-reporter "$*" 2>/dev/null
}

# CGI headers, the web server turns the Status header into the response line
headers() {
    printf 'Status: %s\r\nContent-Type: %s; charset=utf-8\r\nCache-Control: no-store\r\n\r\n' "$1" "$2"
}

# Only fixed strings are passed as messages, never request data
fail() {
    headers "$1" application/json
    printf '{ "error": "%s" }\n' "$2"
    exit 0
}

lower() {
    printf '%s' "$1" | tr 'A-Z' 'a-z'
}

# A device id is also a file name, so only a safe set of characters is allowed
valid_id() {

    case "$1" in
        ''|.*|*[!A-Za-z0-9._-]*) return 1 ;;
    esac

    [ ${#1} -le 64 ]
}

authorized() {

    if [ -z "$TOKEN" ]; then
        return 0
    fi

    [ "$HTTP_AUTHORIZATION" = "Bearer $TOKEN" ]
}

# Decodes %XX and + in a URL path segment
urldecode() {
    local escaped

    escaped=$(printf '%s' "$1" | sed 's/+/ /g; s/\\/\\\\/g; s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')
    printf '%b' "$escaped"
}

# The stored file for an id, a serial or a name, printed on stdout
find_device() {
    local key field file value

    key=$(lower "$1")

    if valid_id "$key" && [ -f "$STATE_DIR/$key.json" ]; then
        echo "$STATE_DIR/$key.json"
        return 0
    fi

    for field in serial name; do

        for file in "$STATE_DIR"/*.json; do

            if [ ! -f "$file" ]; then
                continue
            fi

            value=$(json_file_field "$file" "$field")

            if [ -n "$value" ] && [ "$(lower "$value")" = "$key" ]; then
                echo "$file"
                return 0
            fi
        done
    done

    return 1
}

# ----------------------------------------------------------------------
# Requests
# ----------------------------------------------------------------------

handle_post() {
    local length body r_device_id r_name r_model r_serial r_ip r_port r_ssid r_android r_reason
    local id key file tmp previous endpoint changed now

    if [ -n "${PATH_INFO#/}" ]; then
        fail "404 Not Found" "not found"
    fi

    if ! authorized; then
        log "rejected report from $REMOTE_ADDR: bad token"
        fail "401 Unauthorized" "unauthorized"
    fi

    length=${CONTENT_LENGTH:-0}

    case "$length" in
        ''|*[!0-9]*) fail "400 Bad Request" "bad content length" ;;
    esac

    if [ "$length" -gt "$MAX_BODY" ]; then
        fail "413 Payload Too Large" "report too large"
    fi

    body=$(head -c "$length")

    if ! json_is_object "$body"; then
        fail "400 Bad Request" "bad report: not a JSON object"
    fi

    # Both backends print shell-quoted assignments, missing fields stay empty
    eval "$(json_report_vars "$body")"

    case "$r_ip" in
        ''|*[!0-9A-Fa-f.:]*) fail "400 Bad Request" "bad report: ip" ;;
    esac

    case "$r_port" in
        ''|*[!0-9]*) fail "400 Bad Request" "bad report: port" ;;
    esac

    if [ ${#r_ip} -gt 45 ] || [ ${#r_port} -gt 5 ] || [ "$r_port" -lt 1 ] || [ "$r_port" -gt 65535 ]; then
        fail "400 Bad Request" "bad report: ip or port out of range"
    fi

    id=${r_device_id:-$r_serial}

    if ! valid_id "$id"; then
        fail "400 Bad Request" "bad report: device_id must be letters, digits, dot, dash or underscore"
    fi

    # IPv6 needs brackets in adb connect
    case "$r_ip" in
        *:*) endpoint="[$r_ip]:$r_port" ;;
        *) endpoint="$r_ip:$r_port" ;;
    esac

    key=$(lower "$id")
    file="$STATE_DIR/$key.json"
    previous=$(json_file_field "$file" connect)
    now=$(date +%s)

    # Written next to the target and renamed, so readers never see half a file
    umask 077
    mkdir -p "$STATE_DIR" || fail "500 Internal Server Error" "state directory not writable"
    tmp="$STATE_DIR/.$key.$$"
    json_record > "$tmp" && mv -f "$tmp" "$file" || {
        rm -f "$tmp"
        fail "500 Internal Server Error" "could not store report"
    }

    changed=false

    if [ "$previous" != "$endpoint" ]; then
        changed=true
        log "$id: ${previous:--} -> $endpoint ($r_reason)"
    fi

    # Detached, the phone gets its answer without waiting for the hook
    if [ -n "$HOOK" ] && { [ "$changed" = true ] || [ "$HOOK_ALWAYS" = 1 ]; }; then
        ADB_DEVICE_ID="$id" ADB_NAME="${r_name:-$id}" ADB_IP="$r_ip" ADB_PORT="$r_port" \
            ADB_CONNECT="$endpoint" ADB_PREVIOUS="$previous" ADB_SERIAL="$r_serial" \
            sh -c "$HOOK" </dev/null >/dev/null 2>&1 &
    fi

    headers "200 OK" application/json
    printf '{ "ok": true, "changed": %s }\n' "$changed"
}

handle_get() {
    local path device action file key separator record

    if [ "$OPEN_GET" != 1 ] && ! authorized; then
        fail "401 Unauthorized" "unauthorized"
    fi

    path=${PATH_INFO#/}
    path=${path%/}

    # All devices, one compact record per line
    if [ -z "$path" ]; then
        headers "200 OK" application/json
        printf '{'
        separator=""

        for file in "$STATE_DIR"/*.json; do

            if [ ! -f "$file" ]; then
                continue
            fi

            key=${file##*/}
            key=${key%.json}

            # A damaged file is skipped instead of breaking the whole list
            if ! record=$(describe "$file") || [ -z "$record" ]; then
                continue
            fi

            printf '%s\n  "%s": %s' "$separator" "$key" "$record"
            separator=","
        done

        printf '\n}\n'
        return
    fi

    device=$(urldecode "${path%%/*}")
    action=""

    if [ "$path" != "${path%%/*}" ]; then
        action=${path#*/}
    fi

    if [ -n "$action" ] && [ "$action" != "connect" ]; then
        fail "404 Not Found" "not found"
    fi

    if ! file=$(find_device "$device"); then

        if [ "$action" = "connect" ]; then
            headers "404 Not Found" text/plain
            echo "unknown device"
            exit 0
        fi

        fail "404 Not Found" "unknown device"
    fi

    if [ "$action" = "connect" ]; then
        headers "200 OK" text/plain
        json_file_field "$file" connect
        return
    fi

    headers "200 OK" application/json
    describe "$file" pretty
}

dispatch() {

    case "$REQUEST_METHOD" in
        POST) handle_post ;;
        GET) handle_get ;;
        *) fail "405 Method Not Allowed" "method not allowed" ;;
    esac
}

# The whole answer is built first so it can carry a Content-Length. Without it
# uhttpd sends HTTP/1.1 answers chunked, and the uhttpd snapshot in Alpine
# (before upstream commit 7e64e8b) leaves out the closing chunk, so clients
# report the transfer as cut off. The x keeps trailing newlines of the body,
# the inner subshell lets fail() exit without skipping it
response=$( (dispatch); printf x)
response=${response%x}

separator=$(printf '\r\n\r\nx')
separator=${separator%x}
head=${response%%"$separator"*}
body=${response#*"$separator"}
length=$(printf '%s' "$body" | wc -c | tr -d ' ')

printf '%s\r\nContent-Length: %s\r\n\r\n%s' "$head" "$length" "$body"
